#!/usr/bin/env bash
# NOH ink-as-background gate (CR-006, network-one-design). Lints only STAGED
# CSS/Astro files, ink-only mode (see network-one-design/tools/voice-lint.py
# --ink-only): the shared script's full ruleset targets prose, not product
# code, so a scoped mode avoids false positives on real CSS.
#
# NOT ACTIVE until an operator runs, from the repo root:
#     chmod +x .githooks/pre-commit
#     git config core.hooksPath .githooks
set -euo pipefail

LINT="$HOME/code/network-one-design/tools/voice-lint.py"
[ -f "$LINT" ] || exit 0

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

lint_files=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  [ -f "$f" ] || continue
  case "$f" in
    *.css|*.astro) lint_files="$lint_files $f" ;;
  esac
done <<EOF
$staged
EOF

if [ -n "$lint_files" ]; then
  python3 "$LINT" --ink-only $lint_files
fi

exit 0
