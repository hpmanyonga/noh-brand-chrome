---
/**
 * BrandMark — convenience component for surfacing the canonical NOH lockup
 * outside the header. Use in hero banners, splash sections, footers, etc.
 *
 * Variants pull from the canonical assets bundled in this package (self-hosted
 * at build time by each consuming site — no third-party CDN dependency).
 *
 * Variants:
 *   - "colour" (default) — full lockup on light backgrounds
 *   - "white" — full lockup on dark/teal/green backgrounds
 *   - "black" — full lockup, mono
 *   - "grayscale" — desaturated mono
 *   - "mark-colour" — symbol only (square)
 *   - "mark-white" — symbol only on dark
 */
import nohColour from "../assets/noh-colour.svg?url";
import nohWhite from "../assets/noh-white.svg?url";
import nohBlack from "../assets/noh-black.svg?url";
import nohGrayscale from "../assets/noh-grayscale.svg?url";
import nohMarkColour from "../assets/noh-mark-colour.svg?url";
import nohMarkWhite from "../assets/noh-mark-white.svg?url";

interface Props {
  variant?: "colour" | "white" | "black" | "grayscale" | "mark-colour" | "mark-white";
  width?: number | string;
  height?: number | string;
  alt?: string;
  loading?: "eager" | "lazy";
}

const {
  variant = "colour",
  width = 200,
  height,
  alt = "Network One Health",
  loading = "lazy",
} = Astro.props;

const VARIANTS: Record<string, string> = {
  colour: nohColour,
  white: nohWhite,
  black: nohBlack,
  grayscale: nohGrayscale,
  "mark-colour": nohMarkColour,
  "mark-white": nohMarkWhite,
};

const src = VARIANTS[variant];
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  class="noh-brand-mark"
/>

<style>
  .noh-brand-mark {
    display: inline-block;
    object-fit: contain;
    max-width: 100%;
    height: auto;
  }
</style>
