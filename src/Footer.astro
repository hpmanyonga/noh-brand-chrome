---
/**
 * NOH Footer (PDF B9).
 *
 * Standard footer = green strip, white text: info@networkonehealth.co.za and
 * WhatsApp 071 224 2788, the universal line that handles every centre
 * automatically (HP 2026-08-30). Never drop that number.
 *
 * Compliance footer line (only when `compliance` is true, i.e. on regulated
 * clinical content). Wording and its reasoning are at `complianceLine` below.
 * Identified by BHF practice number, never "HPCSA PR" or an MP number, and
 * never phrased as "clinical services provided by" — sites may use different
 * clinical providers.
 *
 * Cross-brand link (the "elegant, non-disruptive" link to the sister domain)
 * sits as a sub-link inside the strip.
 */

interface Props {
  /** Which domain we're on — drives cross-domain link wording */
  domain: "com" | "coza";
  /** Add the regulated-content compliance attribution line */
  compliance?: boolean;
  /** Practice number to inject into the compliance line (if known).
      Prop name kept as `hpcsaPR` for backwards compatibility. */
  hpcsaPR?: string;
  /** Optional full sitemap links, rendered as a plain list above the
      copyright line. Lets a lean top nav (Header.astro) demote secondary
      pages without making them unreachable. Site-specific — passed in via
      BaseLayout's `footerLinks` prop, not hardcoded here. */
  links?: { label: string; href: string }[];
}

const { domain, compliance = false, hpcsaPR, links = [] } = Astro.props;

const year = new Date().getFullYear();

// Canonical compliance footer. Revised HP 2026-08-30, replacing the 2026-07-10
// wording, which said care is "delivered by your local Network One care team,
// under Network One clinical governance". Network One Health is a management
// company and does not deliver care, so that sentence named the wrong party.
//
// The corrected chain, and the order it must be stated in:
//   Network One Health is the envelope. It contracts the underlying service
//   providers and governs them. Clinical oversight and accountability sit with
//   Dr H P Manyonga & Associates Inc., the regulated entity, which contracts
//   local providers under service level agreements; those providers may be
//   multidisciplinary in their own right.
//
// Integrator framing is preserved deliberately: this never reads as "clinical
// services provided by" the practice. It still survives a site where the
// practice is not itself the treating provider.
const complianceLine = `Network One Health contracts and governs the clinical practices that deliver care at each site. Clinical oversight and accountability sit with Dr H P Manyonga & Associates Inc. (BHF practice number ${hpcsaPR ?? "0977357"}). All guidelines and tools remain the practice's property.`;

// The two sites co-exist permanently, split the way the entities are split
// (HP 2026-09-01): this apex is the regulated gynaecology practice, and
// networkonehealth.co.za is the management company, where service lines other
// than gynaecology and maternity will live. So each should point at the other.
//
// Briefly removed 2026-08-31 on a misreading that the management site was
// mothballed. It is not. What is mothballed is networkonematernity.co.za, and
// mothballing here means a permanent redirect, not switching a site off.
// Removed AGAIN for about 90 minutes on 2026-09-04 (v0.21.0) on the same
// misreading, and restored in v0.22.0 on HP's explicit ruling the same day:
// networkonehealth.co.za is NOT retired and co-exists with hpmanyonga.co.za
// permanently. Do not drop this link without a written HP decision that names
// this domain.
const sister =
  domain === "com"
    ? { label: "Network One Health (SA)", href: "https://hpmanyonga.co.za" }
    : { label: "Network One Health", href: "https://www.networkonehealth.co.za" };
---

<footer class="noh-footer">
  <div class="noh-footer__strip">
    <div class="noh-container noh-footer__strip-inner">
      <ul class="noh-footer__contacts">
        <li>
          <a href="mailto:info@networkonehealth.co.za">info@networkonehealth.co.za</a>
        </li>
        <li>
          <span class="noh-footer__label">WhatsApp:</span>
          <a href="https://wa.me/27712242788">071 224 2788</a>
        </li>
      </ul>
      {/* rel="nofollow" (HP 2026-09-01: "do not point to networkonehealth.co.za
          from the google pages"). The link stays, because the two entities are
          real and each should acknowledge the other. What it must not be is a
          sitewide ranking vote: this is 50-odd dofollow links on every page of
          the estate, aimed at the one domain we are moving the Google Business
          Profile and the ads AWAY from. Keep the relationship, drop the signal. */}
      <a class="noh-footer__sister" href={sister.href} rel="nofollow">
        Also visit: <strong>{sister.label}</strong> →
      </a>
    </div>
  </div>

  <div class="noh-footer__base">
    <div class="noh-container">
      {links.length > 0 && (
        <ul class="noh-footer__sitemap">
          {links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      )}
      {compliance && <p class="noh-footer__compliance">{complianceLine}</p>}
      <p class="noh-footer__copy">
        &copy; {year} Network One Health.
        <a href="/privacy">Privacy</a> ·
        <a href="/terms">Terms</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .noh-footer {
    margin-top: 4rem;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .noh-footer__strip {
    background: var(--noh-green-text);
    color: var(--noh-white);
    padding: 1.5rem 0;
  }
  .noh-footer__strip a { color: var(--noh-white); text-decoration: none; }
  .noh-footer__strip a:hover { text-decoration: underline; }
  .noh-footer__strip-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .noh-footer__contacts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-weight: 500;
  }
  .noh-footer__label {
    opacity: 0.85;
    font-weight: 500;
    margin-right: 0.35rem;
  }
  .noh-footer__sister {
    font-weight: 500;
    opacity: 0.95;
  }
  .noh-footer__base {
    /* Rule (2026-07-28, do not repeat): never let muted/grey text sit
       directly on an exposed page background. Consumer sites may set a
       coloured `html body` canvas (e.g. the green ambient canvas on
       hpmanyonga.co.za), and grey-on-that-green is illegible. Grey text
       only ever renders inside a white/paper panel. */
    background: var(--noh-white);
    padding: 1.25rem 0 2rem;
    color: var(--noh-muted);
    font-size: 0.78rem;
  }
  .noh-footer__sitemap {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.85rem;
  }
  .noh-footer__sitemap a { color: var(--noh-muted); font-weight: 600; }
  .noh-footer__sitemap a:hover { color: var(--noh-teal-text); }
  .noh-footer__compliance {
    margin: 0 0 0.5rem;
    font-style: italic;
  }
  .noh-footer__copy { margin: 0; }
  .noh-footer__copy a { color: var(--noh-muted); margin: 0 0.25rem; }
  @media (max-width: 640px) {
    .noh-footer__strip-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
