---
/**
 * NOH Header — Network One Health ALWAYS leads (PDF B1 hard rule).
 *
 * Practice name "Dr HP Manyonga and Associates Inc." appears ONLY in the
 * compliance footer — never in chrome or hero copy.
 *
 * Logos: uses the canonical NOH mark (just the symbol) at small sizes for
 * crisp display. The full lockup `noh-colour.svg` is preferred for hero
 * banners and footers; use it via the BrandMark component or directly
 * by URL: cdn.jsdelivr.net/gh/hpmanyonga/noh-brand-chrome@main/assets/noh-colour.svg
 */
import BrandPill from "./BrandPill.astro";
import { callbackUrl, EOI_FORM_URL } from "./urls.js";

interface Props {
  /** Which domain we're on — drives BrandPill direction */
  domain: "com" | "coza";
  /** Content positioning hint — does NOT change brand chrome */
  contentType?: "systems" | "clinical" | "subbrand";
  /** Optional nav items */
  nav?: { label: string; href: string }[];
  /** Home href — defaults to "/" */
  home?: string;
  /** Which brand leads the header. "noh" (default) or "practice"
      (the clinician-owned provider estate: hpmanyonga.co.za + join.). */
  lead?: "noh" | "practice";
  /** Prominent header actions (HP rule 2026-07-11: both funnel doors are
      always visible at the top — patient call-back AND provider EOI).
      Pass false to suppress, or an array to override. */
  cta?: { label: string; href: string; variant?: "solid" | "outline" }[] | false;
  /** Set false to suppress the BrandPill cross-domain link (default true). */
  brandPill?: boolean;
}

const { domain, nav = [], home = "/", lead = "noh", cta, brandPill = true } = Astro.props;

const patientCta = { label: "Ask us to call you", href: callbackUrl(`header-${domain}`), variant: "solid" };
const providerCta = { label: "Express interest", href: `${EOI_FORM_URL}?source=header-${domain}`, variant: "outline" };
const headerCtas =
  cta === false
    ? []
    : cta ??
      (lead === "practice" ? [providerCta && { ...providerCta, variant: "solid" }, { ...patientCta, variant: "outline" }] : [patientCta, providerCta]);

const CDN = "https://cdn.jsdelivr.net/gh/hpmanyonga/noh-brand-chrome@main/assets";
const brand =
  lead === "practice"
    ? {
        mark: `${CDN}/hpma-colour.png`,
        name: "Dr H P Manyonga & Associates",
        sub: "The Network One Health provider network",
        aria: "Dr H P Manyonga & Associates home",
      }
    : {
        mark: `${CDN}/noh-mark-colour.svg`,
        name: "Network One Health",
        sub: "Coordinated maternal & women's health",
        aria: "Network One Health home",
      };
---

<header class="noh-header">
  <div class="noh-container noh-header__inner">
    <a class="noh-header__brand" href={home} aria-label={brand.aria}>
      <img
        src={brand.mark}
        alt=""
        class="noh-header__mark"
        width="52"
        height="52"
        loading="eager"
      />
      <span class="noh-header__brand-text">
        <span class="noh-header__brand-name">{brand.name}</span>
        <span class="noh-header__brand-sub">{brand.sub}</span>
      </span>
    </a>

    <button class="noh-header__toggle" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <div class="noh-header__right">
      {headerCtas.map((c) => (
        <a class={`noh-header__cta noh-header__cta--${c.variant ?? "solid"}`} href={c.href} target="_blank" rel="noopener">
          {c.label}
        </a>
      ))}
      {brandPill !== false && <BrandPill domain={domain} />}
    </div>
    {nav.length > 0 && (
      <nav class="noh-header__nav" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    )}
  </div>
</header>

<style>
  .noh-header {
    background: var(--noh-white);
    border-bottom: 1px solid var(--noh-soft-gray);
    padding: 0.85rem 0;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .noh-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .noh-header__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--noh-ink);
    text-decoration: none;
    line-height: 1.15;
  }
  .noh-header__brand:hover { text-decoration: none; }
  .noh-header__mark {
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }
  .noh-header__brand-text { display: flex; flex-direction: column; }
  .noh-header__brand-name {
    font-weight: 700;
    font-size: 1.18rem;
    color: var(--noh-teal);
    letter-spacing: -0.01em;
  }
  .noh-header__brand-sub {
    font-size: 0.72rem;
    color: var(--noh-muted);
    font-weight: 500;
    margin-top: 1px;
  }
  .noh-header__right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: nowrap;
    margin-left: auto;
  }
  .noh-header__nav {
    flex-basis: 100%;
    padding-top: 0.35rem;
  }
  .noh-header__cta {
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.65rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 140ms, box-shadow 140ms, filter 140ms;
  }
  .noh-header__cta--solid {
    background: var(--noh-teal);
    color: var(--noh-white);
    box-shadow: 0 2px 10px rgba(64, 136, 125, 0.25);
  }
  .noh-header__cta--outline {
    border: 2px solid var(--noh-teal);
    color: var(--noh-teal);
    background: transparent;
  }
  .noh-header__cta:hover {
    filter: brightness(0.94);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .noh-header__cta--solid:hover {
    box-shadow: 0 4px 14px rgba(64, 136, 125, 0.35);
  }
  .noh-header__nav {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.4rem;
    gap: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .noh-header__nav a { color: var(--noh-ink); }
  .noh-header__nav a:hover { color: var(--noh-teal); }

  /* hamburger toggle — hidden on desktop */
  .noh-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--noh-soft-gray);
    border-radius: 10px;
    cursor: pointer;
  }
  .noh-header__toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--noh-teal);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .noh-header.is-open .noh-header__toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .noh-header.is-open .noh-header__toggle span:nth-child(2) { opacity: 0; }
  .noh-header.is-open .noh-header__toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 860px) {
    .noh-header__toggle { display: flex; }
    .noh-header__brand-sub { display: none; }
    /* collapse nav + CTAs behind the hamburger */
    .noh-header__right,
    .noh-header__nav { display: none; flex-basis: 100%; }
    .noh-header.is-open .noh-header__right,
    .noh-header.is-open .noh-header__nav {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      margin-left: 0;
    }
    .noh-header.is-open .noh-header__nav {
      gap: 0;
      order: 1;
      margin-top: 0.5rem;
      border-top: 1px solid var(--noh-soft-gray);
      padding-top: 0.5rem;
    }
    .noh-header.is-open .noh-header__nav a {
      padding: 0.75rem 0.25rem;
      border-bottom: 1px solid var(--noh-soft-gray);
      font-size: 1rem;
    }
    .noh-header.is-open .noh-header__right {
      order: 2;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }
    .noh-header.is-open .noh-header__cta {
      text-align: center;
      padding: 0.7rem 1.1rem;
      font-size: 0.95rem;
    }
  }
  /* Extra tightening on narrow phones so the bigger logo/name never
     crowds the hamburger on a ~360-390px viewport. */
  @media (max-width: 400px) {
    .noh-header__mark { width: 40px; height: 40px; }
    .noh-header__brand-name { font-size: 1.02rem; }
  }
</style>

<script>
  // Mobile nav toggle. Runs once; bundled + deduped by Astro across pages.
  document.querySelectorAll(".noh-header__toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const header = btn.closest(".noh-header");
      const open = header.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
  });
</script>
