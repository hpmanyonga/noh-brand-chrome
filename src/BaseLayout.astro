---
/**
 * BaseLayout — default page shell for every NOH site.
 * Applies brand CSS (v2, Arial), renders Header + Footer
 * with the right domain + compliance context.
 */
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "./reset.css";
import "./brand.css";

interface Props {
  title: string;
  description?: string;
  domain: "com" | "coza";
  /** Content positioning hint — does NOT change brand chrome (PDF B1) */
  contentType?: "systems" | "clinical" | "subbrand";
  /** True when this page carries regulated clinical content
      (then footer adds the compliance attribution per PDF B9) */
  compliance?: boolean;
  /** HPCSA practice number to inject into the compliance line */
  hpcsaPR?: string;
  /** Optional canonical URL */
  canonical?: string;
  /** Optional hreflang sister URL on the other domain */
  hreflangSister?: { href: string; lang: string };
  /** Optional nav for header */
  nav?: { label: string; href: string }[];
  /** Optional full sitemap links for the footer (see Footer.astro `links`) */
  footerLinks?: { label: string; href: string }[];
  /** Optional OG image URL */
  ogImage?: string;
  /** OpenGraph type — "website" (default) or "product" for catalogue/product pages */
  ogType?: string;
  /** Which brand leads the header. "noh" (default) or "practice". */
  lead?: "noh" | "practice";
  /** Which funnel this surface serves — see Header.astro. */
  primary?: "patient" | "provider";
  /** Header CTA override — see Header.astro. */
  cta?: { label: string; href: string; variant?: "solid" | "outline" }[] | false;
  /** Set false to suppress the BrandPill cross-domain link in the header. */
  brandPill?: boolean;
}

const {
  title,
  description = "Network One Health — coordinated maternal and women's health care.",
  domain,
  contentType,
  compliance = false,
  hpcsaPR,
  canonical,
  hreflangSister,
  nav = [],
  footerLinks = [],
  ogImage,
  ogType = "website",
  lead = "noh",
  primary,
  cta,
  brandPill,
} = Astro.props;

const lang = domain === "coza" ? "en-ZA" : "en";

// SOCIAL AND SEARCH IMAGERY (2026-09-01).
//
// Twelve of the flagship's 57 indexable pages carried an og:image and the rest
// carried none, so a link to any of the other 45 shared as a bare grey box, and
// Google had no image to attach in the surfaces that use one. Rather than add
// the tag to 45 page templates, an absolute default is derived from the page's
// own canonical URL, which every page already sets. A page that names its own
// ogImage still wins.
//
// Twitter/X card tags were absent entirely. summary_large_image is the only
// sensible choice for a site whose OG images are all 1200x630.
const ogImageResolved =
  ogImage ?? (canonical ? new URL("/img/og-default.jpg", canonical).href : undefined);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangSister && (
      <link rel="alternate" hreflang={hreflangSister.lang} href={hreflangSister.href} />
    )}

    <!-- Typography: Arial system stack (v2 / CR-002 — Inter dropped, zero external font requests) -->

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImageResolved && <meta property="og:image" content={ogImageResolved} />}
    {ogImageResolved && <meta property="og:image:width" content="1200" />}
    {ogImageResolved && <meta property="og:image:height" content="630" />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Network One Health" />
    <meta property="og:locale" content={lang === "en-ZA" ? "en_ZA" : "en_GB"} />

    <!-- Twitter/X -->
    <meta name="twitter:card" content={ogImageResolved ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageResolved && <meta name="twitter:image" content={ogImageResolved} />}

    {/* Favicons. The mark is the PRACTICE monogram, not the NOH logo, because
        the header on these surfaces leads with the practice and a tab icon that
        disagrees with the masthead reads as the wrong site. A favicon is also
        what Google renders beside a search result, and the flagship was serving
        404 for every favicon path until now. Consumers that have not added the
        files simply 404 as they already did. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <slot name="head" />
  </head>
  <body>
    <Header domain={domain} contentType={contentType} nav={nav} lead={lead} primary={primary} cta={cta} brandPill={brandPill} />
    <main>
      <slot />
    </main>
    <Footer domain={domain} compliance={compliance} hpcsaPR={hpcsaPR} links={footerLinks} />

    {/*
      Channel attribution passthrough.

      Every form CTA in the estate carries a hardcoded `source` naming its
      PLACEMENT — header-coza, programmes-maternity, www-coza-home. That is
      useful and stays. What was missing is the CHANNEL: a visitor arriving from
      Pomelli, an ad or a printed QR with ?src=... clicked a CTA and JotForm was
      told only the placement, so every channel looked like direct traffic. The
      36 submissions on the call-back form bear this out: not one carries a
      channel.

      The form has a single hidden field, `source`, so both facts travel in it
      as "channel|placement". Downstream reads it as free text. With no ?src=
      the link is left exactly as it was.

      Held for the session, so the channel survives a visitor browsing several
      pages before converting.

      GOOGLE ADS. A paid click arrives with gclid, or wbraid/gbraid where Google
      cannot set a cookie. Without capturing it, the conversion count in Google
      Ads and the lead count in Notion are two unlinked numbers: you cannot say
      which enrolled patient came from which campaign or keyword, or even that
      they came from paid at all. The click id rides in its own `gclid` form
      field rather than being packed into `source`, because it is the value you
      join on and packing it would make that string fragile to parse. A paid
      visit with no explicit ?src= is labelled channel "google-ads".
    */}
    <script is:inline>
      (function () {
        var KEY = "noh:src", CID = "noh:cid";
        var clean = function (v, n) {
          return v ? String(v).slice(0, n).replace(/[^A-Za-z0-9_.-]/g, "") : "";
        };
        try {
          var qs = new URLSearchParams(location.search);

          var q = clean(qs.get("src"), 64);
          if (q) sessionStorage.setItem(KEY, q);

          // gclid first; wbraid and gbraid are what Google sends when it cannot
          // set a cookie, and either still identifies the campaign.
          var cid = clean(qs.get("gclid") || qs.get("wbraid") || qs.get("gbraid"), 128);
          if (cid) sessionStorage.setItem(CID, cid);
          cid = cid || clean(sessionStorage.getItem(CID), 128);

          // A paid click with no explicit ?src= is still a known channel.
          var channel = q || clean(sessionStorage.getItem(KEY), 64) || (cid ? "google-ads" : "");
          if (!channel && !cid) return;

          document.querySelectorAll('a[href*="form.jotform.com"]').forEach(function (a) {
            var u;
            try { u = new URL(a.href); } catch (e) { return; }
            if (channel) {
              var placement = u.searchParams.get("source");
              if (!placement || placement.indexOf("|") === -1) {
                u.searchParams.set("source", placement ? channel + "|" + placement : channel);
              }
            }
            if (cid) u.searchParams.set("gclid", cid);
            a.href = u.toString();
          });
        } catch (e) {
          /* sessionStorage can throw in private mode; attribution is never worth
             breaking a page over. */
        }
      })();
    </script>
  </body>
</html>
